# Server Configuration
NODE_ENV=development
PORT=3001

# ============================================================================
# Database Configuration
# ============================================================================
# Firestore is used as the primary database. No PostgreSQL required.
# Firebase Admin SDK initializes automatically with GOOGLE_APPLICATION_CREDENTIALS
# or FIREBASE_SERVICE_ACCOUNT env var.
#
# For local development: firebase login + application-default credentials
# For cloud deployment (Render/Vercel): set FIREBASE_SERVICE_ACCOUNT env var
#
# See: https://firebase.google.com/docs/admin/setup#initialize_the_sdk
USE_FIRESTORE=true

# ============================================================================
# Firebase Configuration
# ============================================================================
FIREBASE_PROJECT_ID=city-event-6c6ec

# ============================================================================
# Frontend URLs (for CORS configuration)
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend URL for redirects
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Payment Processing (Stripe)
# ============================================================================
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ============================================================================
# Email Configuration
# ============================================================================
SENDGRID_API_KEY=placeholder
SENDGRID_FROM_EMAIL=noreply@cityevent.com

# ============================================================================
# JWT Configuration
# ============================================================================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=7d
CSRF_SECRET=your-csrf-secret-change-in-production

# ============================================================================
# Email / SMTP Configuration
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@cityevent.com

# ============================================================================
# Optional Third-Party Integrations
# ============================================================================
SENTRY_DSN=
PAYSTACK_SECRET_KEY=placeholder
FIREBASE_APP_CHECK_SECRET=placeholder

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
