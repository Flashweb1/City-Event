# Server Configuration
NODE_ENV=development
PORT=3001

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection (required for backend to start)
DATABASE_URL=postgresql://user:pass@localhost:5432/city_event

# Set to 'true' to use Firestore instead of PostgreSQL (incremental migration)
# When false (default), all routes use PostgreSQL
USE_FIRESTORE=false

# ============================================================================
# Firebase Configuration
# ============================================================================
FIREBASE_PROJECT_ID=city-event-6c6ec

# ============================================================================
# Frontend URLs (for CORS configuration)
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend URL for redirects
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Payment Processing (Stripe)
# ============================================================================
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ============================================================================
# Email Configuration
# ============================================================================
SENDGRID_API_KEY=placeholder
SENDGRID_FROM_EMAIL=noreply@cityevent.com

# ============================================================================
# JWT Configuration
# ============================================================================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=7d
CSRF_SECRET=your-csrf-secret-change-in-production

# ============================================================================
# Email / SMTP Configuration
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@cityevent.com

# ============================================================================
# Optional Third-Party Integrations
# ============================================================================
SENTRY_DSN=
PAYSTACK_SECRET_KEY=placeholder
FIREBASE_APP_CHECK_SECRET=placeholder

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
